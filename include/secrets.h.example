#pragma once
// ============================================================
//  SECRETS — copy to secrets.h and fill in. secrets.h is git-ignored.
//  MQTT role account + password (from the shack password manager).
//  This device uses the iot role.
// ============================================================
// MQTT broker address (your shack broker).
#define MQTT_HOST  "192.168.x.x"
#define MQTT_USER  "iot"
#define MQTT_PASS  ""

// ArduinoOTA password (empty = no password). Set one before the box
// goes into the shack.
#define OTA_PASS   ""

// The box's IP address, used by ota.sh (not by the firmware).
#define OTA_HOST   "192.168.x.x"
