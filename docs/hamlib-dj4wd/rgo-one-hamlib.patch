+/*
+ * rgo_one_init
+ *
+ * RGO-specific initialization:
+ *   ag_format = 2 (AG0xxx format for AF gain, undocumented but likely TS-480 compat)
+ *   micgain_min/max = 0/10 (RGO MG: 000-010, NOT 000-100 like TS-480!)
+ */
+static int rgo_one_init(RIG *rig)
+{
+    struct kenwood_priv_data *priv;
+    int retval;
+
+    ENTERFUNC;
+
+    retval = kenwood_init(rig);
+
+    if (retval != RIG_OK)
+    {
+        RETURNFUNC(retval);
+    }
+
+    priv = (struct kenwood_priv_data *) STATE(rig)->priv;
+
+    priv->ag_format = 2;
+    priv->micgain_min = 0;
+    priv->micgain_max = 10;
+
+    RETURNFUNC(RIG_OK);
+}
+
+/*
+ * rgo_one_open
+ *
+ * Open connection and verify RGO ONE identity.
+ * FW 1.08+: ID; returns "ID006" (model only, short format).
+ * Old FW:   ID; returns "ID006 <fw> <sn1> <sn2>" (long format).
+ *           Warning is logged; connection proceeds normally since most CAT
+ *           commands work on old firmware. FW;/SN; will silently fail.
+ */
+static int rgo_one_open(RIG *rig)
+{
+    int retval;
+    char idbuf[64];
+    struct kenwood_priv_data *priv = (struct kenwood_priv_data *) STATE(rig)->priv;
+
+    ENTERFUNC;
+
+    retval = kenwood_open(rig);
+
+    if (retval != RIG_OK)
+    {
+        RETURNFUNC(retval);
+    }
+
+    retval = kenwood_transaction(rig, "ID", idbuf, sizeof(idbuf));
+
+    if (retval != RIG_OK)
+    {
+        rig_debug(RIG_DEBUG_WARN, "%s: could not read ID, assuming RGO ONE V6\n",
+                  __func__);
+    }
+    else if (strlen(idbuf) < 5 || strncmp(idbuf + 2, "006", 3) != 0)
+    {
+        rig_debug(RIG_DEBUG_WARN,
+                  "%s: unexpected ID '%s' (expected ID006 for RGO ONE V6)\n",
+                  __func__, idbuf);
+    }
+    else if (strchr(idbuf + 5, ' ') != NULL || strlen(idbuf) > 5)
+    {
+        /* Old firmware (< 1.08): ID returns long format "ID006 <fw> <sn> ..." */
+        rig_debug(RIG_DEBUG_WARN,
+                  "%s: RGO ONE V6 old firmware detected (%s)\n"
+                  "   FW 1.08+ recommended -- FW; SN; MC; not available.\n"
+                  "   Most CAT commands work normally. Please consider a firmware update.\n",
+                  __func__, idbuf);
+    }
+    else
+    {
+        rig_debug(RIG_DEBUG_VERBOSE, "%s: RGO ONE V6 identified: %s\n",
+                  __func__, idbuf);
+    }
+
+    priv->is_emulation = 1;
+
+    RETURNFUNC(RIG_OK);
+}
