+/*
+ * RGO ONE V6 - All-Mode HF Transceiver (1.5-30 MHz receive, FW 1.10+;
+ * 1.8-29.7 MHz on older firmware -- see rx_range_list1/2 below)
+ * 50W CW/SSB/FM/RTTY, 12.5W AM
+ * TS-480SAT compatible CAT protocol
+ *
+ * CAT reference: RGO_ONE_V6_CAT_Manual1.03.pdf
+ *
+ * Documented CAT commands (FW 1.08+):
+ *   AC AI BD BU EX FA FB FR FS FT FW GT ID IF KS KY LK MC MD MG ML
+ *   MR MW NB NL PA PB PC PL RA RC RD RG RM RT RU RX SD SM SN TX VD VG XT
+ *
+ * NOT documented (TS-480 only, may or may not work):
+ *   AG0 SQ0 BY PR VX NR SR UP DN VV PT TY
+ */
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "hamlib/rig.h"
+#include "cal.h"
+#include "cache.h"
+#include "idx_builtin.h"
+#include "iofunc.h"
+#include "misc.h"
+#include "register.h"
+#include "serial.h"
+#include "kenwood.h"
+
+#define RGOONE_ALL_MODES (RIG_MODE_LSB|RIG_MODE_USB|RIG_MODE_CW|RIG_MODE_CWR|RIG_MODE_AM|RIG_MODE_FM|RIG_MODE_RTTY)
+#define RGOONE_OTHER_TX_MODES (RIG_MODE_CW|RIG_MODE_CWR|RIG_MODE_LSB|RIG_MODE_USB|RIG_MODE_FM|RIG_MODE_RTTY)
+#define RGOONE_AM_TX_MODES RIG_MODE_AM
+#define RGOONE_VFO (RIG_VFO_A|RIG_VFO_B)
+
+/*
+ * Levels verified against CAT manual:
+ *   PC (000-050), RG (000-100), GT (000-002), MG (000-010),
+ *   KS (005-045), ML (000-010), NL (000-016), PA, RA, PL,
+ *   VD (0000-1200), VG (000-010), SD (0000-1200), SM (0-15),
+ *   RM (0=pwr, 1=ALC, 2=SWR, 3=COMP, reading 0000-0015)
+ *
+ * NOT in CAT manual (delegated to kenwood, may not work):
+ *   AF (AG0), SQL (SQ0), CWPITCH (PT/EX)
+ */
+#define RGOONE_LEVEL_GET (RIG_LEVEL_RFPOWER|RIG_LEVEL_AF|RIG_LEVEL_RF|RIG_LEVEL_SQL|RIG_LEVEL_AGC|RIG_LEVEL_MICGAIN|RIG_LEVEL_STRENGTH|RIG_LEVEL_KEYSPD| \
+    RIG_LEVEL_MONITOR_GAIN|RIG_LEVEL_NB|RIG_LEVEL_PREAMP|RIG_LEVEL_COMP|RIG_LEVEL_ATT|RIG_LEVEL_VOXDELAY|RIG_LEVEL_VOXGAIN|RIG_LEVEL_BKIN_DLYMS| \
+    RIG_LEVEL_SWR|RIG_LEVEL_COMP_METER|RIG_LEVEL_ALC|RIG_LEVEL_RFPOWER_METER)
+
+#define RGOONE_LEVEL_SET (RIG_LEVEL_RFPOWER|RIG_LEVEL_AF|RIG_LEVEL_RF|RIG_LEVEL_SQL|RIG_LEVEL_AGC|RIG_LEVEL_MICGAIN|RIG_LEVEL_KEYSPD| \
+    RIG_LEVEL_MONITOR_GAIN|RIG_LEVEL_NB|RIG_LEVEL_PREAMP|RIG_LEVEL_COMP|RIG_LEVEL_ATT|RIG_LEVEL_VOXDELAY|RIG_LEVEL_VOXGAIN|RIG_LEVEL_BKIN_DLYMS| \
+    RIG_LEVEL_METER)
+
+/*
+ * Functions verified against CAT manual:
+ *   NB (NB cmd), RIT (RT cmd), XIT (XT cmd), TUNER (AC cmd),
+ *   MON (ML cmd), FBKIN (SD cmd), LOCK (LK cmd)
+ *
+ * REMOVED (not in CAT manual):
+ *   COMP (PR cmd not documented, use PL level instead)
+ *   VOX (VX cmd not documented, use VG level, VG000=VOX off)
+ */
+#define RGOONE_FUNC_ALL (RIG_FUNC_NB|RIG_FUNC_RIT|RIG_FUNC_XIT| \
+    RIG_FUNC_TUNER|RIG_FUNC_MON|RIG_FUNC_FBKIN|RIG_FUNC_LOCK)
+
+#define RGOONE_VFO_OPS (RIG_OP_BAND_UP|RIG_OP_BAND_DOWN|RIG_OP_TUNE)
+
+/*
+ * S-meter calibration table
+ * RGO ONE SM: P2 = 0000-0015 (0 = no signal, 15 = max S9+)
+ */
+#define RGOONE_STR_CAL { 7, \
+    { \
+        {   0, -54 }, \
+        {   3, -36 }, \
+        {   5, -24 }, \
+        {   7, -12 }, \
+        {   9,   0 }, \
+        {  12,  20 }, \
+        {  15,  60 } \
+    } }
+
+/*
+ * SWR calibration table
+ * RGO ONE RM meter reading: 0000-0015
+ */
+#define RGOONE_SWR_CAL { 5, \
+    { \
+        {   0, 1.0f }, \
+        {   3, 1.5f }, \
+        {   6, 2.0f }, \
+        {   9, 3.0f }, \
+        {  15, 10.0f } \
+    } }
+
+/*
+ * rgo_one_set_func
+ *
+ * MON: ML command (ML000=off, ML001=on at level 1)
+ * LOCK: LK command (LK00=unlock, LK10=lock; P2=0 always per RGO manual)
+ * Others delegated to kenwood_set_func
+ */
+static int rgo_one_set_func(RIG *rig, vfo_t vfo, setting_t func, int status)
+{
+    char buf[20];
+
+    rig_debug(RIG_DEBUG_TRACE, "%s called\n", __func__);
+
+    switch (func)
+    {
+    case RIG_FUNC_MON:
+        /* RGO ML: 000=off, 001-010=monitor level */
+        SNPRINTF(buf, sizeof(buf), "ML00%c", (status == 0) ? '0' : '1');
+        RETURNFUNC2(kenwood_transaction(rig, buf, NULL, 0));
+
+    case RIG_FUNC_LOCK:
+        /* RGO LK: P1=0/1 (unlock/lock), P2=0 always */
+        SNPRINTF(buf, sizeof(buf), "LK%c0", (status == 0) ? '0' : '1');
+        RETURNFUNC2(kenwood_transaction(rig, buf, NULL, 0));
+
+    default:
+        return kenwood_set_func(rig, vfo, func, status);
+    }
+}
+
+/*
+ * rgo_one_get_func
+ *
+ * MON: ML command, answer MLP1P1P1; (3 digits, >0 means on)
+ * LOCK: LK command, answer LKP1P2; (P1=0/1, P2=0 always)
+ */
+static int rgo_one_get_func(RIG *rig, vfo_t vfo, setting_t func, int *status)
+{
+    char buf[20];
+    int retval;
+
+    ENTERFUNC;
+
+    switch (func)
+    {
+    case RIG_FUNC_MON:
+    {
+        int raw_value;
+        retval = kenwood_safe_transaction(rig, "ML", buf, sizeof(buf), 5);
+
+        if (retval != RIG_OK)
+        {
+            RETURNFUNC(retval);
+        }
+
+        sscanf(buf, "ML%d", &raw_value);
+
+        *status = (raw_value > 0);
+        break;
+    }
+
+    case RIG_FUNC_LOCK:
+        /* RGO LK answer: LKP1P2; where P1=0/1, P2=0 always */
+        retval = kenwood_safe_transaction(rig, "LK", buf, sizeof(buf), 4);
+
+        if (retval != RIG_OK)
+        {
+            RETURNFUNC(retval);
+        }
+
+        *status = buf[2] != '0';
+        break;
+
+    default:
+        RETURNFUNC(kenwood_get_func(rig, vfo, func, status));
+    }
+
+    RETURNFUNC(RIG_OK);
+}
+
+/*
+ * rgo_one_set_level
+ *
+ * RGO-specific level commands with correct value ranges from CAT manual:
+ *   RG: 000-100 (RF gain)
+ *   SQ0: not documented, delegated to kenwood
+ *   GT: 000/001/002 (AGC off/fast/slow)
+ *   ML: 000-010 (monitor gain, 000=off)
+ *   NL: 000-016 (noise blanker level)
+ *   PA: P1P2, P1=0/1, P2=0 (preamp)
+ *   RA: P1P1, 00/01 (attenuator)
+ *   RM: 0-3 (meter select: 0=pwr, 1=ALC, 2=SWR, 3=COMP)
+ *   PC: 000-050 (RF power, 0-50W; kenwood's minmax-logic not compatible)
+ *   VG: 000-010 (VOX gain; kenwood uses 0-9, RGO uses 0-10)
+ *   PL: P1P1P1P2P2P2 (speech processor; P1=input, P2=output, 000-010)
+ *   SD: 0000-1200 ms (CW break-in delay; kenwood caps at 1000ms)
+ */
+static int rgo_one_set_level(RIG *rig, vfo_t vfo, setting_t level,
+                             value_t val)
+{
+    char levelbuf[16];
+    int kenwood_val;
+
+    rig_debug(RIG_DEBUG_TRACE, "%s called\n", __func__);
+
+    switch (level)
+    {
+    case RIG_LEVEL_RF:
+        /* RGO RG: 000-100 */
+        kenwood_val = val.f * 100;
+        SNPRINTF(levelbuf, sizeof(levelbuf), "RG%03d", kenwood_val);
+        break;
+
+    case RIG_LEVEL_AF:
+        /* AG0: not in RGO manual, delegate to kenwood (may work via TS-480 compat) */
+        return kenwood_set_level(rig, vfo, level, val);
+
+    case RIG_LEVEL_SQL:
+        /* SQ0: not in RGO manual, delegate to kenwood (may work via TS-480 compat) */
+        return kenwood_set_level(rig, vfo, level, val);
+
+    case RIG_LEVEL_AGC:
+        /* RGO GT: 000=off, 001=fast, 002=slow */
+        switch (val.i)
+        {
+        case RIG_AGC_OFF:
+            kenwood_val = 0;
+            break;
+
+        case RIG_AGC_FAST:
+            kenwood_val = 1;
+            break;
+
+        case RIG_AGC_SLOW:
+            kenwood_val = 2;
+            break;
+
+        default:
+            rig_debug(RIG_DEBUG_ERR, "%s: unsupported agc value", __func__);
+            return -RIG_EINVAL;
+        }
+
+        SNPRINTF(levelbuf, sizeof(levelbuf), "GT%03d", kenwood_val);
+        break;
+
+    case RIG_LEVEL_MONITOR_GAIN:
+        /* RGO ML: 000-010 (000=off, 001-010=monitor level) */
+        kenwood_val = val.f * 10.0;
+        SNPRINTF(levelbuf, sizeof(levelbuf), "ML%03d", kenwood_val);
+        break;
+
+    case RIG_LEVEL_NB:
+        /* RGO NL: 000-016 */
+        kenwood_val = val.f * 16.0;
+        SNPRINTF(levelbuf, sizeof(levelbuf), "NL%03d", kenwood_val);
+        break;
+
+    case RIG_LEVEL_PREAMP:
+        /* RGO PA set: nur P1 -- "PA1" oder "PA0" (kein P2).
+         * Doku zeigt "PAP1P2;" aber Firmware ignoriert "PA10" stillschweigend.
+         * TS-480-Format "PA1"/"PA0" funktioniert. Answer ist weiterhin "PAP1P2;". */
+        if (val.i != 1 && val.i != 0)
+        {
+            RETURNFUNC2(-RIG_EINVAL);
+        }
+
+        SNPRINTF(levelbuf, sizeof(levelbuf), "PA%c", (val.i == 1) ? '1' : '0');
+        break;
+
+    case RIG_LEVEL_ATT:
+        /* RGO RA: P1=00/01 (off/on) */
+        if (val.i != 1 && val.i != 0)
+        {
+            RETURNFUNC2(-RIG_EINVAL);
+        }
+
+        SNPRINTF(levelbuf, sizeof(levelbuf), "RA%02d", (val.i == 1) ? 1 : 0);
+        break;
+
+    case RIG_LEVEL_METER:
+        /* RGO RM: 0=power, 1=ALC, 2=SWR, 3=COMP */
+        switch (val.i)
+        {
+        case RIG_METER_SWR:
+            kenwood_val = 2;
+            break;
+
+        case RIG_METER_COMP:
+            kenwood_val = 3;
+            break;
+
+        case RIG_METER_ALC:
+            kenwood_val = 1;
+            break;
+
+        default:
+            RETURNFUNC2(-RIG_EINVAL);
+        }
+
+        SNPRINTF(levelbuf, sizeof(levelbuf), "RM%d", kenwood_val);
+        break;
+
+    case RIG_LEVEL_RFPOWER:
+        /* RGO PC: 000-050 (50W max).
+         * kenwood's set_level uses kenwood_get_power_minmax() which sends
+         * "PC;PC000;PC;PC255;PC;PC000;" -- RGO only understands plain "PC;". */
+        kenwood_val = (int)(val.f * 50.0f + 0.5f);
+        if (kenwood_val < 0) { kenwood_val = 0; }
+        if (kenwood_val > 50) { kenwood_val = 50; }
+        SNPRINTF(levelbuf, sizeof(levelbuf), "PC%03d", kenwood_val);
+        break;
+
+    case RIG_LEVEL_VOXGAIN:
+        /* RGO VG: 000-010 (000=VOX off). kenwood uses 0-9 scale. */
+        kenwood_val = (int)(val.f * 10.0f + 0.5f);
+        SNPRINTF(levelbuf, sizeof(levelbuf), "VG%03d", kenwood_val);
+        break;
+
+    case RIG_LEVEL_COMP:
+        /* RGO PL: P1=input (000-010), P2=output (000-010, 000=compressor off).
+         * kenwood uses 0-100 scale; RGO uses 0-10. Both parameters set equal. */
+        kenwood_val = (int)(val.f * 10.0f + 0.5f);
+        SNPRINTF(levelbuf, sizeof(levelbuf), "PL%03d%03d", kenwood_val, kenwood_val);
+        break;
+
+    case RIG_LEVEL_BKIN_DLYMS:
+        /* RGO SD: 0000-1200 ms (direct ms, P1 range per manual).
+         * kenwood_set_level caps at 1000 ms; RGO supports up to 1200 ms. */
+        if (val.i < 0 || val.i > 1200)
+        {
+            RETURNFUNC2(-RIG_EINVAL);
+        }
+        SNPRINTF(levelbuf, sizeof(levelbuf), "SD%04d", val.i);
+        break;
+
+    default:
+        return kenwood_set_level(rig, vfo, level, val);
+    }
+
+    return kenwood_transaction(rig, levelbuf, NULL, 0);
+}
+
+/*
+ * rgo_one_read_meter
+ *
+ * RGO RM command:
+ *   Set: RMP1;  (select meter: 0=power, 1=ALC, 2=SWR, 3=COMP)
+ *   Read: RM;
+ *   Answer: RMP1P2P2P2P2;  (P1=meter type, P2=4-digit reading 0000-0015)
+ *
+ * This is different from TS-480 which returns all meters at once!
+ */
+static int rgo_one_read_meter(RIG *rig, int meter_type, int *meter_value)
+{
+    int retval;
+    char cmdbuf[10];
+    char ackbuf[20];
+    int type_read;
+    int value_read;
+
+    ENTERFUNC;
+
+    /* Select the desired meter */
+    SNPRINTF(cmdbuf, sizeof(cmdbuf), "RM%d", meter_type);
+    retval = kenwood_transaction(rig, cmdbuf, NULL, 0);
+
+    if (retval != RIG_OK)
+    {
+        RETURNFUNC(retval);
+    }
+
+    /* Read the meter value */
+    retval = kenwood_safe_transaction(rig, "RM", ackbuf, sizeof(ackbuf), 7);
+
+    if (retval != RIG_OK)
+    {
+        RETURNFUNC(retval);
+    }
+
+    /* Parse: RMP1P2P2P2P2 */
+    if (sscanf(ackbuf, "RM%1d%4d", &type_read, &value_read) != 2)
+    {
+        rig_debug(RIG_DEBUG_ERR, "%s: unexpected response '%s'\n", __func__, ackbuf);
+        RETURNFUNC(-RIG_EPROTO);
+    }
+
+    *meter_value = value_read;
+
+    RETURNFUNC(RIG_OK);
+}
+
+/*
+ * rgo_one_get_level
+ *
+ * Level reading with RGO-specific value ranges and formats.
+ */
+static int rgo_one_get_level(RIG *rig, vfo_t vfo, setting_t level,
+                             value_t *val)
+{
+    char ackbuf[50];
+    size_t ack_len, ack_len_expected;
+    int levelint;
+    int retval;
+
+    ENTERFUNC;
+
+    switch (level)
+    {
+    case RIG_LEVEL_AF:
+        /* AG0: not in RGO manual, delegate to kenwood */
+        RETURNFUNC(kenwood_get_level(rig, vfo, level, val));
+
+    case RIG_LEVEL_RF:
+        /* RGO RG: 000-100 */
+        retval = kenwood_transaction(rig, "RG", ackbuf, sizeof(ackbuf));
+
+        if (RIG_OK != retval)
+        {
+            RETURNFUNC(retval);
+        }
+
+        ack_len = strlen(ackbuf);
+
+        if (5 != ack_len)
+        {
+            RETURNFUNC(-RIG_EPROTO);
+        }
+
+        if (1 != sscanf(&ackbuf[2], "%d", &levelint))
+        {
+            RETURNFUNC(-RIG_EPROTO);
+        }
+
+        val->f = levelint / (float) 100;
+        RETURNFUNC(RIG_OK);
+
+    case RIG_LEVEL_SQL:
+        /* SQ0: not in RGO manual, delegate to kenwood */
+        RETURNFUNC(kenwood_get_level(rig, vfo, level, val));
+
+    case RIG_LEVEL_AGC:
+        /* RGO GT: 000/001/002 */
+        retval = kenwood_transaction(rig, "GT", ackbuf, sizeof(ackbuf));
+        ack_len_expected = 5;
+
+        if (RIG_OK != retval)
+        {
+            RETURNFUNC(retval);
+        }
+
+        ack_len = strlen(ackbuf);
+
+        if (ack_len != ack_len_expected)
+        {
+            RETURNFUNC(-RIG_EPROTO);
+        }
+
+        switch (ackbuf[ack_len_expected - 1])
+        {
+        case '0':
+            val->i = RIG_AGC_OFF;
+            break;
+
+        case '1':
+            val->i = RIG_AGC_FAST;
+            break;
+
+        case '2':
+            val->i = RIG_AGC_SLOW;
+            break;
+
+        default:
+            RETURNFUNC(-RIG_EPROTO);
+        }
+
+        RETURNFUNC(RIG_OK);
+
+    case RIG_LEVEL_STRENGTH:
+    {
+        /* RGO SM: SM0P2P2P2P2; P2=0000-0015.
+         * kenwood_get_level sends bare "SM" (no VFO digit) for non-TS480 rigs
+         * which the RGO does not understand. Send "SM0" directly. */
+        int raw_value;
+        if (CACHE(rig)->ptt != RIG_PTT_OFF)
+        {
+            val->i = -9 * 6;
+            RETURNFUNC(RIG_OK);
+        }
+        retval = kenwood_safe_transaction(rig, "SM0", ackbuf, sizeof(ackbuf), 7);
+        if (retval != RIG_OK) { RETURNFUNC(retval); }
+        sscanf(ackbuf + 3, "%d", &raw_value);
+        val->i = (int)rig_raw2val(raw_value, &rig->caps->str_cal);
+        RETURNFUNC(RIG_OK);
+    }
+
+    case RIG_LEVEL_MONITOR_GAIN:
+    {
+        /* RGO ML: 000-010 */
+        int raw_value;
+        retval = kenwood_safe_transaction(rig, "ML", ackbuf, sizeof(ackbuf), 5);
+
+        if (retval != RIG_OK)
+        {
+            RETURNFUNC(retval);
+        }
+
+        sscanf(ackbuf, "ML%d", &raw_value);
+
+        val->f = (float) raw_value / 10.0f;
+        break;
+    }
+
+    case RIG_LEVEL_NB:
+    {
+        /* RGO NL: 000-016 */
+        int raw_value;
+        retval = kenwood_safe_transaction(rig, "NL", ackbuf, sizeof(ackbuf), 5);
+
+        if (retval != RIG_OK)
+        {
+            RETURNFUNC(retval);
+        }
+
+        sscanf(ackbuf, "NL%d", &raw_value);
+
+        val->f = (float) raw_value / 16.0f;
+        break;
+    }
+
+    case RIG_LEVEL_PREAMP:
+        /* RGO PA: answer PAP1P2; (P1=0/1, P2=0) = 4 chars */
+        retval = kenwood_safe_transaction(rig, "PA", ackbuf, sizeof(ackbuf), 4);
+
+        if (retval != RIG_OK)
+        {
+            RETURNFUNC(retval);
+        }
+
+        val->i = ackbuf[2] == '1' ? 1 : 0;
+        break;
+
+    case RIG_LEVEL_ATT:
+        /* RGO RA: answer RAP1P1P2P2; = 6 chars, P1=00/01 */
+        retval = kenwood_safe_transaction(rig, "RA", ackbuf, sizeof(ackbuf), 6);
+
+        if (retval != RIG_OK)
+        {
+            RETURNFUNC(retval);
+        }
+
+        val->i = ackbuf[3] == '1' ? 1 : 0;
+        break;
+
+    case RIG_LEVEL_SWR:
+    {
+        /* RGO RM: meter 2 = SWR, reading 0000-0015 */
+        int meter_val;
+
+        retval = rgo_one_read_meter(rig, 2, &meter_val);
+
+        if (retval != RIG_OK)
+        {
+            RETURNFUNC(retval);
+        }
+
+        if (rig->caps->swr_cal.size)
+        {
+            val->f = rig_raw2val_float(meter_val, &rig->caps->swr_cal);
+        }
+        else
+        {
+            val->f = (float) meter_val / 2.0f;
+        }
+
+        break;
+    }
+
+    case RIG_LEVEL_COMP_METER:
+    {
+        /* RGO RM: meter 3 = COMP, reading 0000-0015 */
+        int meter_val;
+
+        retval = rgo_one_read_meter(rig, 3, &meter_val);
+
+        if (retval != RIG_OK)
+        {
+            RETURNFUNC(retval);
+        }
+
+        val->f = (float) meter_val;
+        break;
+    }
+
+    case RIG_LEVEL_ALC:
+    {
+        /* RGO RM: meter 1 = ALC, reading 0000-0015 */
+        int meter_val;
+
+        retval = rgo_one_read_meter(rig, 1, &meter_val);
+
+        if (retval != RIG_OK)
+        {
+            RETURNFUNC(retval);
+        }
+
+        val->f = (float) meter_val / 4.0f;
+        break;
+    }
+
+    case RIG_LEVEL_RFPOWER_METER:
+    {
+        /* RGO SM: P1=0, P2=0000-0015 */
+        int raw_value;
+
+        if (CACHE(rig)->ptt == RIG_PTT_OFF)
+        {
+            val->f = 0;
+            break;
+        }
+
+        retval = kenwood_safe_transaction(rig, "SM0", ackbuf, sizeof(ackbuf), 7);
+
+        if (retval != RIG_OK)
+        {
+            RETURNFUNC(retval);
+        }
+
+        sscanf(ackbuf, "SM0%d", &raw_value);
+
+        val->f = (float) raw_value / 15.0f;
+        break;
+    }
+
+    case RIG_LEVEL_RFPOWER:
+    {
+        /* RGO PC: 000-050 (50W max). kenwood uses kenwood_get_power_minmax()
+         * which is incompatible with RGO's plain "PC;" query. */
+        int raw_value;
+        retval = kenwood_safe_transaction(rig, "PC", ackbuf, sizeof(ackbuf), 5);
+
+        if (retval != RIG_OK)
+        {
+            RETURNFUNC(retval);
+        }
+
+        sscanf(ackbuf + 2, "%d", &raw_value);
+        val->f = (float) raw_value / 50.0f;
+        RETURNFUNC(RIG_OK);
+    }
+
+    case RIG_LEVEL_VOXGAIN:
+    {
+        /* RGO VG: 000-010 (000=VOX off). kenwood uses 0-9 scale. */
+        int raw_value;
+        retval = kenwood_safe_transaction(rig, "VG", ackbuf, sizeof(ackbuf), 5);
+
+        if (retval != RIG_OK)
+        {
+            RETURNFUNC(retval);
+        }
+
+        sscanf(ackbuf + 2, "%d", &raw_value);
+        val->f = (float) raw_value / 10.0f;
+        RETURNFUNC(RIG_OK);
+    }
+
+    case RIG_LEVEL_COMP:
+    {
+        /* RGO PL: PLP1P1P1P2P2P2 - P2 ist Output-Level (Position 5-7). */
+        int raw_value;
+        retval = kenwood_safe_transaction(rig, "PL", ackbuf, sizeof(ackbuf), 8);
+
+        if (retval != RIG_OK)
+        {
+            RETURNFUNC(retval);
+        }
+
+        sscanf(ackbuf + 5, "%3d", &raw_value);
+        val->f = (float) raw_value / 10.0f;
+        RETURNFUNC(RIG_OK);
+    }
+
+    case RIG_LEVEL_BKIN_DLYMS:
+    {
+        /* RGO SD: 0000-1200 ms. kenwood_get_level ist kompatibel, aber wir
+         * ueberschreiben um den kenwood-Pfad mit cap 1000ms zu umgehen. */
+        int raw_value;
+        retval = kenwood_safe_transaction(rig, "SD", ackbuf, sizeof(ackbuf), 6);
+
+        if (retval != RIG_OK)
+        {
+            RETURNFUNC(retval);
+        }
+
+        sscanf(ackbuf + 2, "%d", &raw_value);
+        val->i = raw_value;
+        RETURNFUNC(RIG_OK);
+    }
+
+    default:
+        RETURNFUNC(kenwood_get_level(rig, vfo, level, val));
+    }
+
+    RETURNFUNC(RIG_OK);
+}
+
+/*
+ * rgo_one_post_set_rts  (Windows only)
+ *
+ * Windows usbser.sys does not send SET_CONTROL_LINE_STATE to the device when
+ * only RTS changes -- it only sends the request when DTR is modified, carrying
+ * the current RTS state along as a passenger.  Reading DTR and writing it back
+ * unchanged forces the request and delivers the new RTS state to the firmware.
+ */
+#if defined(WIN32)
+static int rgo_one_post_set_rts(RIG *rig, hamlib_port_t *port, int state)
+{
+    int dtr_state;
+
+    rig_debug(RIG_DEBUG_VERBOSE,
+              "%s: WIN32 usbser.sys workaround: no-op DTR write after RTS=%d\n",
+              __func__, state);
+
+    if (ser_get_dtr(port, &dtr_state) == RIG_OK)
+        ser_set_dtr(port, dtr_state);
+
+    return RIG_OK;
+}
+#endif /* WIN32 */
+
+/*
+ * rgo_one_read_live_mode
+ *
+ * Safety-net helper: reads the rig's active mode with a plain "MD;" query.
+ * The TX/CW/mode-set guards must not use kenwood_get_mode() for this: with
+ * is_emulation set (as in this backend) kenwood_get_mode() returns RIG_OK
+ * *without writing *mode* when called for RIG_VFO_B, which left the guards
+ * reading an uninitialised variable. MD does not depend on the VFO argument
+ * anyway -- it always reports the mode the rig is in right now, which is
+ * what matters before keying. *mode is RIG_MODE_NONE on any failure.
+ */
+static int rgo_one_read_live_mode(RIG *rig, rmode_t *mode)
+{
+    char buf[20];
+    int retval, kmode;
+
+    *mode = RIG_MODE_NONE;
+
+    retval = kenwood_safe_transaction(rig, "MD", buf, sizeof(buf), 3);
+
+    if (retval != RIG_OK)
+    {
+        return retval;
+    }
+
+    kmode = (buf[2] <= '9') ? buf[2] - '0' : buf[2] - 'A' + 10;
+    *mode = kenwood2rmode(kmode, kenwood_caps(rig)->mode_table);
+
+    /* same RTTY->PKT remapping as kenwood_get_mode() applies for emulations */
+    if (*mode == RIG_MODE_RTTY) { *mode = RIG_MODE_PKTLSB; }
+
+    if (*mode == RIG_MODE_RTTYR) { *mode = RIG_MODE_PKTUSB; }
+
+    return RIG_OK;
+}
+
+/*
+ * rgo_one_set_mode
+ *
+ * Safety net: RGO MD is a fire-and-forget set command (no confirmation
+ * in the response). A hardware incident (CW keyed while the rig was
+ * still in SSB, destroying the driver transistor) showed that we cannot
+ * assume a mode-set command actually took effect just because the
+ * transaction returned RIG_OK -- the firmware itself does not guarantee
+ * this either. Read the mode back immediately and fail loudly on
+ * mismatch instead of letting the caller believe a mode change happened
+ * that didn't.
+ */
+static int rgo_one_set_mode(RIG *rig, vfo_t vfo, rmode_t mode, pbwidth_t width)
+{
+    int retval;
+    rmode_t confirmed_mode = RIG_MODE_NONE;
+
+    ENTERFUNC;
+
+    retval = kenwood_set_mode(rig, vfo, mode, width);
+
+    if (retval != RIG_OK)
+    {
+        RETURNFUNC(retval);
+    }
+
+    retval = rgo_one_read_live_mode(rig, &confirmed_mode);
+
+    if (retval != RIG_OK)
+    {
+        rig_debug(RIG_DEBUG_ERR,
+                  "%s: mode set to %s but could not verify by readback: %s\n",
+                  __func__, rig_strrmode(mode), rigerror(retval));
+        RETURNFUNC(retval);
+    }
+
+    if (confirmed_mode != mode)
+    {
+        rig_debug(RIG_DEBUG_ERR,
+                  "%s: mode verification failed -- requested %s, rig reports %s\n",
+                  __func__, rig_strrmode(mode), rig_strrmode(confirmed_mode));
+        RETURNFUNC(-RIG_EPROTO);
+    }
+
+    RETURNFUNC(RIG_OK);
+}
+
+/*
+ * rgo_one_set_ptt
+ *
+ * kenwood_set_ptt sends bare "TX;" for RIG_PTT_ON, but the RGO ONE
+ * requires a P1 parameter. TX; without P1 is not accepted by the rig.
+ * Documented TX modes: TX0 (normal/mic), TX2 (tune). TX1 is not in the
+ * CAT manual -- RIG_PTT_ON_DATA is mapped to TX0 for maximum compatibility
+ * with logging and digital mode software (WSJT-X, fldigi, etc.).
+ *
+ * Safety net: the firmware does not reliably guard against keying in an
+ * unexpected mode (see rgo_one_set_mode comment above -- this is what
+ * destroyed a driver transistor). We cannot know the caller's *intended*
+ * mode here (the Hamlib PTT API carries no mode parameter), but we can
+ * at least refuse to key if the CAT link cannot confirm a sane, known
+ * mode right now. Callers (e.g. test scripts) are still responsible for
+ * verifying the *correct* mode via rig_get_mode() before every TX.
+ */
+static int rgo_one_set_ptt(RIG *rig, vfo_t vfo, ptt_t ptt)
+{
+    const char *cmd;
+    int retval;
+
+    ENTERFUNC;
+
+    switch (ptt)
+    {
+    case RIG_PTT_ON:
+    case RIG_PTT_ON_MIC:
+    case RIG_PTT_ON_DATA:
+    {
+        rmode_t cur_mode = RIG_MODE_NONE;
+
+        retval = rgo_one_read_live_mode(rig, &cur_mode);
+
+        if (retval != RIG_OK)
+        {
+            rig_debug(RIG_DEBUG_ERR,
+                      "%s: refusing TX -- could not read current mode: %s\n",
+                      __func__, rigerror(retval));
+            RETURNFUNC(retval);
+        }
+
+        if (cur_mode == RIG_MODE_NONE)
+        {
+            rig_debug(RIG_DEBUG_ERR,
+                      "%s: refusing TX -- rig reports no valid mode\n", __func__);
+            RETURNFUNC(-RIG_EPROTO);
+        }
+
+        cmd = "TX0";
+        break;
+    }
+
+    case RIG_PTT_OFF:
+        cmd = "RX";
+        break;
+
+    default:
+        RETURNFUNC(-RIG_EINVAL);
+    }
+
+    retval = kenwood_transaction(rig, cmd, NULL, 0);
+
+    if (ptt == RIG_PTT_OFF) { hl_usleep(100 * 1000); }
+
+    RETURNFUNC(retval);
+}
+
+/*
+ * rgo_one_send_morse
+ *
+ * Safety net: kenwood_send_morse() sends raw "KY" commands directly,
+ * bypassing rig_set_ptt()/rgo_one_set_ptt() entirely -- none of the pre-TX
+ * mode checks there apply to this path. Upstream rig_send_morse() (src/rig.c)
+ * already refuses non-CW/CWR modes, but via rig_get_mode(), which may serve
+ * a cached value up to 500ms old instead of a live read. Re-verify live,
+ * immediately before keying -- CW must never be keyed unless the rig is
+ * confirmed, right now, to be in CW or CWR.
+ */
+static int rgo_one_send_morse(RIG *rig, vfo_t vfo, const char *msg)
+{
+    rmode_t cur_mode = RIG_MODE_NONE;
+    int retval;
+
+    ENTERFUNC;
+
+    retval = rgo_one_read_live_mode(rig, &cur_mode);
+
+    if (retval != RIG_OK)
+    {
+        rig_debug(RIG_DEBUG_ERR,
+                  "%s: refusing CW keying -- could not read current mode: %s\n",
+                  __func__, rigerror(retval));
+        RETURNFUNC(retval);
+    }
+
+    if ((cur_mode & (RIG_MODE_CW | RIG_MODE_CWR)) == 0)
+    {
+        rig_debug(RIG_DEBUG_ERR,
+                  "%s: refusing CW keying -- rig is in %s, not CW/CWR\n",
+                  __func__, rig_strrmode(cur_mode));
+        RETURNFUNC(-RIG_EINVAL);
+    }
+
+    RETURNFUNC(kenwood_send_morse(rig, vfo, msg));
+}
+
+/*
+ * rgo_one_send_voice_mem / rgo_one_stop_voice_mem
+ *
+ * RGO PB command: plays back stored CW/SSB memory messages (channels 1-4).
+ * Not previously wired to the Hamlib API at all -- only reachable via raw
+ * CAT, with zero protection (not even the weak cache-based check
+ * rig_send_morse() has for live CW keying).
+ *
+ * The CAT manual documents PB as playing "CW/SSB memory messages" from the
+ * same four channels -- there is no way via CAT to know which type of
+ * content is stored in a given channel. Given that keying CW in the wrong
+ * mode is exactly what destroyed a driver transistor in the field, this
+ * errs conservatively: playback is only permitted while the rig is
+ * confirmed, live, to be in CW or CWR. A legitimate SSB memory message
+ * stored on a channel would also be blocked by this -- an inconvenience,
+ * not a hazard; the reverse (an unverified CW message played back in the
+ * wrong mode) would not be.
+ */
+static int rgo_one_send_voice_mem(RIG *rig, vfo_t vfo, int ch)
+{
+    char buf[8];
+    rmode_t cur_mode = RIG_MODE_NONE;
+    int retval;
+
+    ENTERFUNC;
+
+    if (ch < 1 || ch > 4)
+    {
+        RETURNFUNC(-RIG_EINVAL);
+    }
+
+    retval = rgo_one_read_live_mode(rig, &cur_mode);
+
+    if (retval != RIG_OK)
+    {
+        rig_debug(RIG_DEBUG_ERR,
+                  "%s: refusing memory message playback -- could not read current mode: %s\n",
+                  __func__, rigerror(retval));
+        RETURNFUNC(retval);
+    }
+
+    if ((cur_mode & (RIG_MODE_CW | RIG_MODE_CWR)) == 0)
+    {
+        rig_debug(RIG_DEBUG_ERR,
+                  "%s: refusing memory message playback -- rig is in %s, not CW/CWR "
+                  "(channel content type cannot be verified via CAT)\n",
+                  __func__, rig_strrmode(cur_mode));
+        RETURNFUNC(-RIG_EINVAL);
+    }
+
+    SNPRINTF(buf, sizeof(buf), "PB%d", ch);
+    RETURNFUNC(kenwood_transaction(rig, buf, NULL, 0));
+}
+
+static int rgo_one_stop_voice_mem(RIG *rig, vfo_t vfo)
+{
+    ENTERFUNC;
+
+    /* Stop is always safe to allow unconditionally -- it can only reduce
+     * TX activity, never trigger it. */
+    RETURNFUNC(kenwood_transaction(rig, "PB0", NULL, 0));
+}
+
+/*
+ * rgo_one_vfo_op
+ *
+ * RIG_OP_TUNE: RGO uses "TX2;" to activate the built-in antenna tuner
+ * (transmit in tune mode). kenwood_vfo_op would send "AC111;" which is
+ * wrong for this rig. All other ops delegate to kenwood_vfo_op.
+ */
+static int rgo_one_vfo_op(RIG *rig, vfo_t vfo, vfo_op_t op)
+{
+    ENTERFUNC;
+
+    if (op == RIG_OP_TUNE)
+    {
+        RETURNFUNC(kenwood_transaction(rig, "TX2", NULL, 0));
+    }
+
+    RETURNFUNC(kenwood_vfo_op(rig, vfo, op));
+}
+
+/*
+ * rgo_one_set_rit
+ *
+ * RGO RIT/XIT offset setting, limited to +/-5 kHz
+ * Uses RC (clear), RU (up), RD (down) commands.
+ * RGO manual: RU/RD P1 = 00000-00500 with 10Hz steps (0-5kHz)
+ */
+static int rgo_one_set_rit(RIG *rig, vfo_t vfo, shortfreq_t rit)
+{
+    char buf[20];
+    int retval;
+    int rit_enabled;
+    int xit_enabled;
+
+    ENTERFUNC;
+
+    if (rit < -5000 || rit > 5000)
+    {
+        RETURNFUNC(-RIG_EINVAL);
+    }
+
+    /* RC clear command cannot be executed if RIT/XIT is not enabled */
+
+    retval = kenwood_get_func(rig, vfo, RIG_FUNC_RIT, &rit_enabled);
+
+    if (retval != RIG_OK)
+    {
+        RETURNFUNC(retval);
+    }
+
+    if (!rit_enabled)
+    {
+        retval = kenwood_get_func(rig, vfo, RIG_FUNC_XIT, &xit_enabled);
+
+        if (retval != RIG_OK)
+        {
+            RETURNFUNC(retval);
+        }
+    }
+
+    if (!rit_enabled && !xit_enabled)
+    {
+        retval = kenwood_set_func(rig, vfo, RIG_FUNC_RIT, 1);
+
+        if (retval != RIG_OK)
+        {
+            RETURNFUNC(retval);
+        }
+    }
+
+    retval = kenwood_transaction(rig, "RC", NULL, 0);
+
+    if (retval != RIG_OK)
+    {
+        RETURNFUNC(retval);
+    }
+
+    if (!rit_enabled && !xit_enabled)
+    {
+        retval = kenwood_set_func(rig, vfo, RIG_FUNC_RIT, 0);
+
+        if (retval != RIG_OK)
+        {
+            RETURNFUNC(retval);
+        }
+    }
+
+    if (rit == 0)
+    {
+        RETURNFUNC(RIG_OK);
+    }
+
+    SNPRINTF(buf, sizeof(buf), "R%c%05d", (rit > 0) ? 'U' : 'D',
+             abs((int) rit) / 10);  /* RU/RD P1 in 10 Hz steps */
+    retval = kenwood_transaction(rig, buf, NULL, 0);
+
+    RETURNFUNC(retval);
+}
+
+/*
+ * rgo_one_get_rit
+ *
+ * Read RIT/XIT offset from IF command response (TS-480 compatible format).
+ */
+static int rgo_one_get_rit(RIG *rig, vfo_t vfo, shortfreq_t *rit)
+{
+    int retval;
+    char buf[7];
+    struct kenwood_priv_data *priv = STATE(rig)->priv;
+
+    ENTERFUNC;
+
+    if (!rit)
+    {
+        RETURNFUNC(-RIG_EINVAL);
+    }
+
+    retval = kenwood_get_if(rig);
+
+    if (retval != RIG_OK)
+    {
+        RETURNFUNC(retval);
+    }
+
+    memcpy(buf, &priv->info[18], 5);
+
+    buf[6] = '\0';
+    *rit = atoi(buf);
+
+    RETURNFUNC(RIG_OK);
+}
+
+/*
+ * rgo_one_get_info
+ *
+ * FW 1.08+: ID; returns "ID006" (model only), FW; returns firmware version,
+ *           SN; returns µC serial numbers.
+ * Old FW:   ID; returns "ID006 <fw> <sn1> <sn2>" -- FW;/SN; not available.
+ */
+static const char *rgo_one_get_info(RIG *rig)
+{
+    static char infobuf[128];
+    char idbuf[16];
+    char fwbuf[16];
+    char snbuf[64];
+    char fw_str[16] = "";
+    char sn_str[64] = "";
+    int fw_major, fw_minor;
+    int retval;
+
+    retval = kenwood_transaction(rig, "ID", idbuf, sizeof(idbuf));
+
+    if (retval != RIG_OK || strlen(idbuf) < 5 || strncmp(idbuf + 2, "006", 3) != 0)
+    {
+        return "RGO ONE V6";
+    }
+
+    /* FW: "FW0108" (FW 1.08+); silently ignored on old firmware */
+    retval = kenwood_transaction(rig, "FW", fwbuf, sizeof(fwbuf));
+
+    if (retval == RIG_OK && strlen(fwbuf) == 6 && strncmp(fwbuf, "FW", 2) == 0
+        && sscanf(fwbuf + 2, "%2d%2d", &fw_major, &fw_minor) == 2)
+    {
+        SNPRINTF(fw_str, sizeof(fw_str), " FW%d.%02d", fw_major, fw_minor);
+    }
+
+    /* SN: "SN 20303656 32435013 005D0069" (FW 1.08+); silently ignored on old firmware */
+    retval = kenwood_transaction(rig, "SN", snbuf, sizeof(snbuf));
+
+    if (retval == RIG_OK && strlen(snbuf) > 2 && strncmp(snbuf, "SN", 2) == 0)
+    {
+        const char *sn_data = snbuf + 2;
+        while (*sn_data == ' ') { sn_data++; }
+        SNPRINTF(sn_str, sizeof(sn_str), " SN:%s", sn_data);
+    }
+
+    SNPRINTF(infobuf, sizeof(infobuf), "RGO ONE V6 ID006%s%s", fw_str, sn_str);
+    return infobuf;
+}
+
+/*
+ * rgo_one_set_mem
+ *
+ * MC command: recall memory channel 00-99.
+ * Activates the stored frequency/mode from the given memory slot.
+ */
+static int rgo_one_set_mem(RIG *rig, vfo_t vfo, int ch)
+{
+    char buf[10];
+
+    ENTERFUNC;
+
+    if (ch < 0 || ch > 99)
+    {
+        RETURNFUNC(-RIG_EINVAL);
+    }
+
+    SNPRINTF(buf, sizeof(buf), "MC0%02d", ch);
+    RETURNFUNC(kenwood_transaction(rig, buf, NULL, 0));
+}
+
+/*
+ * rgo_one_get_mem
+ *
+ * MC query: returns current memory channel (000-099).
+ */
+static int rgo_one_get_mem(RIG *rig, vfo_t vfo, int *ch)
+{
+    char ackbuf[16];
+    int retval;
+    int channel;
+
+    ENTERFUNC;
+
+    retval = kenwood_safe_transaction(rig, "MC", ackbuf, sizeof(ackbuf), 5);
+
+    if (retval != RIG_OK)
+    {
+        RETURNFUNC(retval);
+    }
+
+    if (sscanf(ackbuf, "MC%d", &channel) != 1)
+    {
+        RETURNFUNC(-RIG_EPROTO);
+    }
+
+    *ch = channel;
+    RETURNFUNC(RIG_OK);
+}
+
+/*
+ * RGO MR/MW memory channel format (CAT manual v1.03):
+ *
+ *   MR[P1][P2][CH][FREQ][MODE][STEP][NB][PRE][ATT][AGC][FIL]
+ *
+ *   P1   1 char   0=RX slot  1=TX slot (split)
+ *   P2   1 char   always 0
+ *   CH   2 chars  channel number 00-99
+ *   FREQ 11 chars frequency in Hz
+ *   MODE 1 char   1=LSB 2=USB 3=CW 4=FM 5=AM 6=Digi 7=CW-R
+ *   STEP 1 char   0=1Hz 1=10Hz 2=100Hz 3=1kHz
+ *   NB   1 char   0/1
+ *   PRE  1 char   0/1
+ *   ATT  1 char   0/1
+ *   AGC  1 char   2=fast 3=slow
+ *   FIL  1 char   0/1
+ *
+ *   Total response: 24 chars (without ';').
+ *   Empty channel: FREQ field is all zeros -> -RIG_ENAVAIL.
+ *   MW has no response (write-only).
+ *   Split: TX slot (P1=1) freq != 0 and != RX freq -> RIG_SPLIT_ON.
+ */
+
+static rmode_t rgo_digit_to_mode(int d)
+{
+    switch (d)
+    {
+    case 1: return RIG_MODE_LSB;
+    case 2: return RIG_MODE_USB;
+    case 3: return RIG_MODE_CW;
+    case 4: return RIG_MODE_FM;
+    case 5: return RIG_MODE_AM;
+    case 6: return RIG_MODE_RTTY;
+    case 7: return RIG_MODE_CWR;
+    default: return RIG_MODE_NONE;
+    }
+}
+
+static int rgo_mode_to_digit(rmode_t mode)
+{
+    switch (mode)
+    {
+    case RIG_MODE_LSB:              return 1;
+    case RIG_MODE_USB:              return 2;
+    case RIG_MODE_CW:               return 3;
+    case RIG_MODE_FM:               return 4;
+    case RIG_MODE_AM:               return 5;
+    case RIG_MODE_RTTY:
+    case RIG_MODE_PKTUSB:
+    case RIG_MODE_PKTLSB:           return 6;
+    case RIG_MODE_CWR:              return 7;
+    default:                        return 2;   /* default USB */
+    }
+}
+
+/*
+ * rgo_one_read_mr_slot
+ *
+ * Reads frequency and mode digit of one memory slot (MR P1=slot) for the
+ * write verification in set_channel/delete_channel.
+ * Empty channel: FW >= 1.09 does not answer (timeout), older FW answers with
+ * frequency 0.  Both are reported as *freq = 0.
+ */
+static int rgo_one_read_mr_slot(RIG *rig, int slot, int ch, freq_t *freq,
+                                int *mode_digit)
+{
+    char cmd[16];
+    char buf[32];
+    char fstr[12];
+    int retval;
+
+    SNPRINTF(cmd, sizeof(cmd), "MR%d0%02d", slot, ch);
+    retval = kenwood_safe_transaction(rig, cmd, buf, sizeof(buf), 24);
+
+    if (retval == -RIG_ETIMEOUT)
+    {
+        *freq = 0;
+        *mode_digit = 0;
+        return RIG_OK;
+    }
+
+    if (retval != RIG_OK)
+        return retval;
+
+    if (strncmp(buf, cmd, 6) != 0)
+    {
+        rig_debug(RIG_DEBUG_ERR, "%s: unexpected answer '%s' to '%s'\n",
+                  __func__, buf, cmd);
+        return -RIG_EPROTO;
+    }
+
+    memcpy(fstr, buf + 6, 11);
+    fstr[11] = '\0';
+    *freq = (freq_t) atoll(fstr);
+    *mode_digit = buf[17] - '0';
+
+    return RIG_OK;
+}
+
+/*
+ * rgo_one_get_channel
+ *
+ * Reads memory channel data via MR command (P1=0 for RX slot, P1=1 for TX slot).
+ * FW < 1.09:  empty channel returns 24-char all-zero response -> freq=0 -> -RIG_ENAVAIL.
+ * FW >= 1.09: empty channel returns no response -> kenwood_safe_transaction times out.
+ * Split detected when TX freq != 0 and TX freq != RX freq.
+ * If read_only=0: additionally recalls the channel via MC (activates it on rig).
+ */
+static int rgo_one_get_channel(RIG *rig, vfo_t vfo, channel_t *chan,
+                                int read_only)
+{
+    char cmd[16];
+    char buf[32];
+    char fstr[12];
+    int retval, ch;
+    freq_t rx_freq, tx_freq;
+
+    ENTERFUNC;
+
+    if (!chan)
+        RETURNFUNC(-RIG_EINVAL);
+
+    ch = chan->channel_num;
+
+    if (ch < 0 || ch > 99)
+        RETURNFUNC(-RIG_EINVAL);
+
+    /* Read RX slot: MR00CH */
+    SNPRINTF(cmd, sizeof(cmd), "MR00%02d", ch);
+    retval = kenwood_safe_transaction(rig, cmd, buf, sizeof(buf), 24);
+
+    if (retval != RIG_OK)
+        RETURNFUNC(retval);
+
+    /* Empty channel: all-zero frequency field */
+    memcpy(fstr, buf + 6, 11);
+    fstr[11] = '\0';
+    rx_freq = (freq_t) atoll(fstr);
+
+    if (rx_freq == 0)
+        RETURNFUNC(-RIG_ENAVAIL);
+
+    memset(chan, 0, sizeof(channel_t));
+    chan->channel_num = ch;
+    chan->vfo         = RIG_VFO_VFO;
+    chan->freq        = rx_freq;
+    chan->mode        = rgo_digit_to_mode(buf[17] - '0');
+    chan->width       = rig_passband_normal(rig, chan->mode);
+
+    switch (buf[18] - '0')
+    {
+    case 1: chan->tuning_step = 10;   break;
+    case 2: chan->tuning_step = 100;  break;
+    case 3: chan->tuning_step = 1000; break;
+    default: chan->tuning_step = 1;
+    }
+
+    if (buf[19] == '1')
+        chan->funcs |= RIG_FUNC_NB;
+
+    chan->levels[rig_setting2idx(RIG_LEVEL_PREAMP)].i = (buf[20] == '1') ? 1 : 0;
+    chan->levels[rig_setting2idx(RIG_LEVEL_ATT)].i    = (buf[21] == '1') ? 1 : 0;
+    chan->levels[rig_setting2idx(RIG_LEVEL_AGC)].i    =
+        (buf[22] == '3') ? RIG_AGC_SLOW : RIG_AGC_FAST;
+
+    /* Read TX slot: MR10CH (reuse cmd, flip P1 digit) */
+    cmd[2] = '1';
+    retval = kenwood_safe_transaction(rig, cmd, buf, sizeof(buf), 24);
+
+    if (retval != RIG_OK)
+        RETURNFUNC(retval);
+
+    memcpy(fstr, buf + 6, 11);
+    tx_freq = (freq_t) atoll(fstr);
+
+    if (tx_freq != 0 && tx_freq != rx_freq)
+    {
+        chan->tx_freq  = tx_freq;
+        chan->tx_mode  = rgo_digit_to_mode(buf[17] - '0');
+        chan->tx_width = rig_passband_normal(rig, chan->tx_mode);
+        chan->split    = RIG_SPLIT_ON;
+    }
+    else
+    {
+        chan->tx_freq  = RIG_FREQ_NONE;
+        chan->tx_mode  = RIG_MODE_NONE;
+        chan->split    = RIG_SPLIT_OFF;
+    }
+
+    /* read_only=0: activate channel on rig */
+    if (!read_only)
+    {
+        char mc[10];
+        SNPRINTF(mc, sizeof(mc), "MC0%02d", ch);
+        retval = kenwood_transaction(rig, mc, NULL, 0);
+
+        if (retval != RIG_OK)
+            RETURNFUNC(retval);
+    }
+
+    RETURNFUNC(RIG_OK);
+}
+
+/*
+ * rgo_one_set_channel
+ *
+ * Writes memory channel data via MW command.
+ * Always writes both RX slot (P1=0) and TX slot (P1=1).
+ * For non-split: TX slot freq = RX freq.  Writing TX freq=0 causes the
+ * firmware to delete the channel entirely (observed behaviour).
+ * MW has no response from the rig.  FW 1.10 (CAT manual 1.04) silently
+ * ignores MW while the rig is in memory mode, so each slot is read back via
+ * MR and a mismatch of frequency or mode is reported as -RIG_ERJCTED.
+ */
+static int rgo_one_set_channel(RIG *rig, vfo_t vfo, const channel_t *chan)
+{
+    char buf[64];
+    int ch, rx_mode, tx_mode, agc, tx_agc, step, retval, rb_mode;
+    freq_t tx_freq, rb_freq;
+
+    ENTERFUNC;
+
+    if (!chan)
+        RETURNFUNC(-RIG_EINVAL);
+
+    ch = chan->channel_num;
+
+    if (ch < 0 || ch > 99)
+        RETURNFUNC(-RIG_EINVAL);
+
+    rx_mode = rgo_mode_to_digit(chan->mode);
+
+    /* AGC: P10 = 2(fast) or 3(slow) */
+    agc = (chan->levels[rig_setting2idx(RIG_LEVEL_AGC)].i == RIG_AGC_SLOW) ? 3 : 2;
+
+    /* Tuning step: map Hz -> P6 digit */
+    if      (chan->tuning_step >= 1000) step = 3;
+    else if (chan->tuning_step >= 100)  step = 2;
+    else if (chan->tuning_step >= 10)   step = 1;
+    else                                step = 0;
+
+    /* MW P1=0: RX slot */
+    SNPRINTF(buf, sizeof(buf), "MW00%02d%011lld%d%d%d%d%d%d%d",
+             ch,
+             (long long) chan->freq,
+             rx_mode,
+             step,
+             (chan->funcs & RIG_FUNC_NB)                          ? 1 : 0,
+             chan->levels[rig_setting2idx(RIG_LEVEL_PREAMP)].i    ? 1 : 0,
+             chan->levels[rig_setting2idx(RIG_LEVEL_ATT)].i       ? 1 : 0,
+             agc,
+             0);    /* FIL: not stored in channel_t */
+
+    retval = kenwood_transaction(rig, buf, NULL, 0);
+
+    if (retval != RIG_OK)
+        RETURNFUNC(retval);
+
+    retval = rgo_one_read_mr_slot(rig, 0, ch, &rb_freq, &rb_mode);
+
+    if (retval != RIG_OK)
+        RETURNFUNC(retval);
+
+    if ((long long) rb_freq != (long long) chan->freq || rb_mode != rx_mode)
+    {
+        rig_debug(RIG_DEBUG_ERR, "%s: channel %d RX slot not written "
+                  "(read back %.0f Hz mode %d) - rig in memory mode?\n",
+                  __func__, ch, rb_freq, rb_mode);
+        RETURNFUNC(-RIG_ERJCTED);
+    }
+
+    /* MW P1=1: TX slot */
+    if (chan->split == RIG_SPLIT_ON && chan->tx_freq > 0)
+    {
+        tx_freq = chan->tx_freq;
+        tx_mode = rgo_mode_to_digit(chan->tx_mode != RIG_MODE_NONE
+                                    ? chan->tx_mode : chan->mode);
+        tx_agc  = agc;
+    }
+    else
+    {
+        /* Not split: TX slot mirrors RX freq.  Writing TX freq=0 would
+         * cause the firmware to delete the channel (observed). */
+        tx_freq = chan->freq;
+        tx_mode = rx_mode;
+        tx_agc  = agc;
+    }
+
+    SNPRINTF(buf, sizeof(buf), "MW10%02d%011lld%d%d%d%d%d%d%d",
+             ch,
+             (long long) tx_freq,
+             tx_mode,
+             step,
+             0, 0, 0,   /* NB, PRE, ATT */
+             tx_agc,
+             0);        /* FIL */
+
+    retval = kenwood_transaction(rig, buf, NULL, 0);
+
+    if (retval != RIG_OK)
+        RETURNFUNC(retval);
+
+    retval = rgo_one_read_mr_slot(rig, 1, ch, &rb_freq, &rb_mode);
+
+    if (retval != RIG_OK)
+        RETURNFUNC(retval);
+
+    if ((long long) rb_freq != (long long) tx_freq || rb_mode != tx_mode)
+    {
+        rig_debug(RIG_DEBUG_ERR, "%s: channel %d TX slot not written "
+                  "(read back %.0f Hz mode %d)\n",
+                  __func__, ch, rb_freq, rb_mode);
+        RETURNFUNC(-RIG_ERJCTED);
+    }
+
+    RETURNFUNC(RIG_OK);
+}
+
+/*
+ * rgo_one_delete_channel
+ *
+ * Deletes a memory channel by writing MW P1=0 with FREQ=0.
+ * Firmware >= 1.09: P1=0 + FREQ=0 is the explicit delete command.
+ * Firmware < 1.09:  P1=0 + FREQ=0 also cleared the channel (same effect).
+ * FW 1.10 ignores MW in memory mode without answer, so the RX slot is read
+ * back: still a frequency there -> -RIG_ERJCTED.
+ */
+static int rgo_one_delete_channel(RIG *rig, vfo_t vfo, const channel_t *chan)
+{
+    char buf[32];
+    int ch, retval, rb_mode;
+    freq_t rb_freq;
+
+    ENTERFUNC;
+
+    if (!chan)
+        RETURNFUNC(-RIG_EINVAL);
+
+    ch = chan->channel_num;
+
+    if (ch < 0 || ch > 99)
+        RETURNFUNC(-RIG_EINVAL);
+
+    SNPRINTF(buf, sizeof(buf), "MW00%02d%011d0000000", ch, 0);
+    retval = kenwood_transaction(rig, buf, NULL, 0);
+
+    if (retval != RIG_OK)
+        RETURNFUNC(retval);
+
+    retval = rgo_one_read_mr_slot(rig, 0, ch, &rb_freq, &rb_mode);
+
+    if (retval != RIG_OK)
+        RETURNFUNC(retval);
+
+    if (rb_freq != 0)
+    {
+        rig_debug(RIG_DEBUG_ERR, "%s: channel %d not deleted "
+                  "(still %.0f Hz) - rig in memory mode?\n",
+                  __func__, ch, rb_freq);
+        RETURNFUNC(-RIG_ERJCTED);
+    }
+
+    RETURNFUNC(RIG_OK);
+}
+
+static struct kenwood_priv_caps rgo_one_priv_caps =
+{
+    .cmdtrm = EOM_KEN,
+};
