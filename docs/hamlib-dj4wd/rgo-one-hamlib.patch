+/*
+ * RGO ONE V1-V5 - All-Mode HF Transceiver
+ * Atmel AVR microcontroller, FTDI USB chip
+ * Reduced TS-480SAT-compatible CAT protocol (firmware 2.51a)
+ *
+ * Confirmed working CAT commands (Don WB8YQJ, fw2.51a, Jan 2024):
+ *   AG0 BD BU FA FB FR FS FT GT ID IF KS LK MD RC RT RU RX TX0
+ *
+ * Key differences from V6:
+ *   - ID; returns ID020 (same as TS-480SAT, not ID006)
+ *   - TX1, TX2 not available (only TX0 and RX)
+ *   - No AC, PC, RA, RD, RG, RM, SM, NL, ML, PL, SD, VD, VG
+ *   - No RTS workaround needed (FTDI chip handles RTS correctly on Windows)
+ *   - XIT not confirmed; omitted from FUNC list
+ *
+ * ID detection: ID response is NOT used for strict model matching.
+ * Sub-versions of V1-V5 may return different values; any ID is accepted.
+ *
+ * Testing: backend untested against real V1-V5 hardware by the author.
+ * Based on verified command list from Don WB8YQJ (fw2.51a).
+ */
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "hamlib/rig.h"
+#include "cal.h"
+#include "idx_builtin.h"
+#include "iofunc.h"
+#include "misc.h"
+#include "register.h"
+#include "serial.h"
+#include "kenwood.h"
+
+#define RGOONE_V1V5_ALL_MODES (RIG_MODE_LSB|RIG_MODE_USB|RIG_MODE_CW|RIG_MODE_CWR|RIG_MODE_AM|RIG_MODE_FM|RIG_MODE_RTTY)
+#define RGOONE_V1V5_OTHER_TX_MODES (RIG_MODE_CW|RIG_MODE_CWR|RIG_MODE_LSB|RIG_MODE_USB|RIG_MODE_FM|RIG_MODE_RTTY)
+#define RGOONE_V1V5_AM_TX_MODES RIG_MODE_AM
+#define RGOONE_V1V5_VFO (RIG_VFO_A|RIG_VFO_B)
+
+/*
+ * Confirmed levels (fw2.51a):
+ *   GT (AGC 000/001/002), AG0 (AF gain, via kenwood), SQ0 (squelch, via kenwood),
+ *   KS (keyer speed 005-045 WPM)
+ *
+ * NOT confirmed: PC, RG, SM, ML, NL, PA, RA, PL, SD, VD, VG, RM meters
+ */
+#define RGOONE_V1V5_LEVEL_GET (RIG_LEVEL_AF|RIG_LEVEL_SQL|RIG_LEVEL_AGC|RIG_LEVEL_KEYSPD)
+#define RGOONE_V1V5_LEVEL_SET (RIG_LEVEL_AF|RIG_LEVEL_SQL|RIG_LEVEL_AGC|RIG_LEVEL_KEYSPD)
+
+/*
+ * Confirmed functions (fw2.51a):
+ *   RIT (RT), LOCK (LK)
+ *
+ * NOT confirmed: XIT (XT not in command list), NB, TUNER, MON, FBKIN
+ */
+#define RGOONE_V1V5_FUNC_ALL (RIG_FUNC_RIT|RIG_FUNC_LOCK)
+
+/* BD and BU confirmed; TUNE (TX2) not available */
+#define RGOONE_V1V5_VFO_OPS (RIG_OP_BAND_UP|RIG_OP_BAND_DOWN)
+
+/*
+ * rgo_one_v1v5_set_func
+ *
+ * LOCK: LK command (LK00=unlock, LK10=lock; P2=0 always, same as V6).
+ * Others delegated to kenwood_set_func.
+ */
+static int rgo_one_v1v5_set_func(RIG *rig, vfo_t vfo, setting_t func, int status)
+{
+    char buf[20];
+
+    rig_debug(RIG_DEBUG_TRACE, "%s called\n", __func__);
+
+    switch (func)
+    {
+    case RIG_FUNC_LOCK:
+        SNPRINTF(buf, sizeof(buf), "LK%c0", (status == 0) ? '0' : '1');
+        RETURNFUNC2(kenwood_transaction(rig, buf, NULL, 0));
+
+    default:
+        return kenwood_set_func(rig, vfo, func, status);
+    }
+}
+
+/*
+ * rgo_one_v1v5_get_func
+ *
+ * LOCK: LK answer LKP1P2; (P1=0/1, P2=0 always).
+ */
+static int rgo_one_v1v5_get_func(RIG *rig, vfo_t vfo, setting_t func, int *status)
+{
+    char buf[20];
+    int retval;
+
+    ENTERFUNC;
+
+    switch (func)
+    {
+    case RIG_FUNC_LOCK:
+        retval = kenwood_safe_transaction(rig, "LK", buf, sizeof(buf), 4);
+
+        if (retval != RIG_OK)
+        {
+            RETURNFUNC(retval);
+        }
+
+        *status = buf[2] != '0';
+        break;
+
+    default:
+        RETURNFUNC(kenwood_get_func(rig, vfo, func, status));
+    }
+
+    RETURNFUNC(RIG_OK);
+}
+
+/*
+ * rgo_one_v1v5_set_level
+ *
+ * Only AGC (GT) requires a custom implementation.
+ * AF (AG0) and SQL (SQ0) are handled by kenwood via ag_format=2.
+ * KS (keyer speed) is handled by kenwood.
+ */
+static int rgo_one_v1v5_set_level(RIG *rig, vfo_t vfo, setting_t level,
+                                  value_t val)
+{
+    char levelbuf[16];
+    int kenwood_val;
+
+    rig_debug(RIG_DEBUG_TRACE, "%s called\n", __func__);
+
+    switch (level)
+    {
+    case RIG_LEVEL_AGC:
+        switch (val.i)
+        {
+        case RIG_AGC_OFF:
+            kenwood_val = 0;
+            break;
+
+        case RIG_AGC_FAST:
+            kenwood_val = 1;
+            break;
+
+        case RIG_AGC_SLOW:
+            kenwood_val = 2;
+            break;
+
+        default:
+            rig_debug(RIG_DEBUG_ERR, "%s: unsupported agc value", __func__);
+            return -RIG_EINVAL;
+        }
+
+        SNPRINTF(levelbuf, sizeof(levelbuf), "GT%03d", kenwood_val);
+        return kenwood_transaction(rig, levelbuf, NULL, 0);
+
+    default:
+        return kenwood_set_level(rig, vfo, level, val);
+    }
+}
+
+/*
+ * rgo_one_v1v5_get_level
+ */
+static int rgo_one_v1v5_get_level(RIG *rig, vfo_t vfo, setting_t level,
+                                  value_t *val)
+{
+    char ackbuf[50];
+    size_t ack_len, ack_len_expected;
+    int retval;
+
+    ENTERFUNC;
+
+    switch (level)
+    {
+    case RIG_LEVEL_AGC:
+        retval = kenwood_transaction(rig, "GT", ackbuf, sizeof(ackbuf));
+        ack_len_expected = 5;
+
+        if (RIG_OK != retval)
+        {
+            RETURNFUNC(retval);
+        }
+
+        ack_len = strlen(ackbuf);
+
+        if (ack_len != ack_len_expected)
+        {
+            RETURNFUNC(-RIG_EPROTO);
+        }
+
+        switch (ackbuf[ack_len_expected - 1])
+        {
+        case '0':
+            val->i = RIG_AGC_OFF;
+            break;
+
+        case '1':
+            val->i = RIG_AGC_FAST;
+            break;
+
+        case '2':
+            val->i = RIG_AGC_SLOW;
+            break;
+
+        default:
+            RETURNFUNC(-RIG_EPROTO);
+        }
+
+        RETURNFUNC(RIG_OK);
+
+    default:
+        RETURNFUNC(kenwood_get_level(rig, vfo, level, val));
+    }
+}
+
+/*
+ * rgo_one_read_live_mode
+ *
+ * Safety-net helper: reads the rig's active mode with a plain "MD;" query.
+ * The TX/CW/mode-set guards must not use kenwood_get_mode() for this: with
+ * is_emulation set (as in this backend) kenwood_get_mode() returns RIG_OK
+ * *without writing *mode* when called for RIG_VFO_B, which left the guards
+ * reading an uninitialised variable. MD does not depend on the VFO argument
+ * anyway -- it always reports the mode the rig is in right now, which is
+ * what matters before keying. *mode is RIG_MODE_NONE on any failure.
+ */
+static int rgo_one_read_live_mode(RIG *rig, rmode_t *mode)
+{
+    char buf[20];
+    int retval, kmode;
+
+    *mode = RIG_MODE_NONE;
+
+    retval = kenwood_safe_transaction(rig, "MD", buf, sizeof(buf), 3);
+
+    if (retval != RIG_OK)
+    {
+        return retval;
+    }
+
+    kmode = (buf[2] <= '9') ? buf[2] - '0' : buf[2] - 'A' + 10;
+    *mode = kenwood2rmode(kmode, kenwood_caps(rig)->mode_table);
+
+    /* same RTTY->PKT remapping as kenwood_get_mode() applies for emulations */
+    if (*mode == RIG_MODE_RTTY) { *mode = RIG_MODE_PKTLSB; }
+
+    if (*mode == RIG_MODE_RTTYR) { *mode = RIG_MODE_PKTUSB; }
+
+    return RIG_OK;
+}
+
+/*
+ * rgo_one_v1v5_set_mode
+ *
+ * Safety net (see rgo_one_v6.c rgo_one_set_mode for the incident this
+ * addresses): RGO MD is a fire-and-forget set command with no
+ * confirmation in the response. A mode-set command returning RIG_OK does
+ * not guarantee the rig actually changed mode -- the firmware itself
+ * does not guard against this. Read the mode back immediately and fail
+ * loudly on mismatch instead of letting the caller believe a mode change
+ * happened that didn't.
+ */
+static int rgo_one_v1v5_set_mode(RIG *rig, vfo_t vfo, rmode_t mode, pbwidth_t width)
+{
+    int retval;
+    rmode_t confirmed_mode = RIG_MODE_NONE;
+
+    ENTERFUNC;
+
+    retval = kenwood_set_mode(rig, vfo, mode, width);
+
+    if (retval != RIG_OK)
+    {
+        RETURNFUNC(retval);
+    }
+
+    retval = rgo_one_read_live_mode(rig, &confirmed_mode);
+
+    if (retval != RIG_OK)
+    {
+        rig_debug(RIG_DEBUG_ERR,
+                  "%s: mode set to %s but could not verify by readback: %s\n",
+                  __func__, rig_strrmode(mode), rigerror(retval));
+        RETURNFUNC(retval);
+    }
+
+    if (confirmed_mode != mode)
+    {
+        rig_debug(RIG_DEBUG_ERR,
+                  "%s: mode verification failed -- requested %s, rig reports %s\n",
+                  __func__, rig_strrmode(mode), rig_strrmode(confirmed_mode));
+        RETURNFUNC(-RIG_EPROTO);
+    }
+
+    RETURNFUNC(RIG_OK);
+}
+
+/*
+ * rgo_one_v1v5_set_ptt
+ *
+ * Only TX0 (normal transmit) and RX are confirmed on V1-V5.
+ * TX1 (data) and TX2 (tune) are not implemented.
+ *
+ * Safety net: refuse to key TX if the CAT link cannot confirm a sane,
+ * known mode right now (see rgo_one_v6.c rgo_one_set_ptt for rationale --
+ * this addresses a real hardware incident on V6, same architecture here).
+ * Callers remain responsible for verifying the *correct* mode via
+ * rig_get_mode() before every TX -- this API carries no mode parameter.
+ */
+static int rgo_one_v1v5_set_ptt(RIG *rig, vfo_t vfo, ptt_t ptt)
+{
+    const char *cmd;
+    int retval;
+
+    ENTERFUNC;
+
+    switch (ptt)
+    {
+    case RIG_PTT_ON:
+    case RIG_PTT_ON_MIC:
+    case RIG_PTT_ON_DATA:
+    {
+        rmode_t cur_mode = RIG_MODE_NONE;
+
+        retval = rgo_one_read_live_mode(rig, &cur_mode);
+
+        if (retval != RIG_OK)
+        {
+            rig_debug(RIG_DEBUG_ERR,
+                      "%s: refusing TX -- could not read current mode: %s\n",
+                      __func__, rigerror(retval));
+            RETURNFUNC(retval);
+        }
+
+        if (cur_mode == RIG_MODE_NONE)
+        {
+            rig_debug(RIG_DEBUG_ERR,
+                      "%s: refusing TX -- rig reports no valid mode\n", __func__);
+            RETURNFUNC(-RIG_EPROTO);
+        }
+
+        cmd = "TX0";
+        break;
+    }
+
+    case RIG_PTT_OFF:
+        cmd = "RX";
+        break;
+
+    default:
+        RETURNFUNC(-RIG_EINVAL);
+    }
+
+    retval = kenwood_transaction(rig, cmd, NULL, 0);
+
+    if (ptt == RIG_PTT_OFF) { hl_usleep(100 * 1000); }
+
+    RETURNFUNC(retval);
+}
+
+/*
+ * rgo_one_v1v5_send_morse
+ *
+ * Safety net (see rgo_one_v6.c rgo_one_send_morse for full rationale):
+ * kenwood_send_morse() sends raw "KY" commands directly, bypassing
+ * rig_set_ptt()/rgo_one_v1v5_set_ptt() entirely. Upstream rig_send_morse()
+ * (src/rig.c) already refuses non-CW/CWR modes, but via rig_get_mode(),
+ * which may serve a cached value up to 500ms old instead of a live read.
+ * Re-verify live, immediately before keying. Note: KY is not in the
+ * confirmed-working command list for V1-V5 (fw2.51a) -- guarded regardless,
+ * since an unconfirmed command on unfamiliar hardware is more reason for
+ * caution, not less.
+ */
+static int rgo_one_v1v5_send_morse(RIG *rig, vfo_t vfo, const char *msg)
+{
+    rmode_t cur_mode = RIG_MODE_NONE;
+    int retval;
+
+    ENTERFUNC;
+
+    retval = rgo_one_read_live_mode(rig, &cur_mode);
+
+    if (retval != RIG_OK)
+    {
+        rig_debug(RIG_DEBUG_ERR,
+                  "%s: refusing CW keying -- could not read current mode: %s\n",
+                  __func__, rigerror(retval));
+        RETURNFUNC(retval);
+    }
+
+    if ((cur_mode & (RIG_MODE_CW | RIG_MODE_CWR)) == 0)
+    {
+        rig_debug(RIG_DEBUG_ERR,
+                  "%s: refusing CW keying -- rig is in %s, not CW/CWR\n",
+                  __func__, rig_strrmode(cur_mode));
+        RETURNFUNC(-RIG_EINVAL);
+    }
+
+    RETURNFUNC(kenwood_send_morse(rig, vfo, msg));
+}
+
+/*
+ * rgo_one_v1v5_set_rit
+ *
+ * RU (up) and RC (clear) are confirmed on V1-V5.
+ * RD (down) is NOT available -- negative offsets cannot be set.
+ */
+static int rgo_one_v1v5_set_rit(RIG *rig, vfo_t vfo, shortfreq_t rit)
+{
+    char buf[20];
+    int retval;
+    int rit_enabled;
+    int xit_enabled;
+
+    ENTERFUNC;
+
+    if (rit < 0)
+    {
+        /* RD not available on V1-V5 */
+        RETURNFUNC(-RIG_ENAVAIL);
+    }
+
+    if (rit > 5000)
+    {
+        RETURNFUNC(-RIG_EINVAL);
+    }
+
+    retval = kenwood_get_func(rig, vfo, RIG_FUNC_RIT, &rit_enabled);
+
+    if (retval != RIG_OK)
+    {
+        RETURNFUNC(retval);
+    }
+
+    xit_enabled = 0;
+
+    if (!rit_enabled && !xit_enabled)
+    {
+        retval = kenwood_set_func(rig, vfo, RIG_FUNC_RIT, 1);
+
+        if (retval != RIG_OK)
+        {
+            RETURNFUNC(retval);
+        }
+    }
+
+    retval = kenwood_transaction(rig, "RC", NULL, 0);
+
+    if (retval != RIG_OK)
+    {
+        RETURNFUNC(retval);
+    }
+
+    if (!rit_enabled && !xit_enabled)
+    {
+        retval = kenwood_set_func(rig, vfo, RIG_FUNC_RIT, 0);
+
+        if (retval != RIG_OK)
+        {
+            RETURNFUNC(retval);
+        }
+    }
+
+    if (rit == 0)
+    {
+        RETURNFUNC(RIG_OK);
+    }
+
+    /* RU P1 in 10 Hz steps (same as V6 RU/RD) */
+    SNPRINTF(buf, sizeof(buf), "RU%05d", (int) rit / 10);
+    retval = kenwood_transaction(rig, buf, NULL, 0);
+
+    RETURNFUNC(retval);
+}
+
+/*
+ * rgo_one_v1v5_get_rit
+ *
+ * Read RIT offset from IF frame (TS-480 compatible, position 18).
+ */
+static int rgo_one_v1v5_get_rit(RIG *rig, vfo_t vfo, shortfreq_t *rit)
+{
+    int retval;
+    char buf[7];
+    struct kenwood_priv_data *priv = STATE(rig)->priv;
+
+    ENTERFUNC;
+
+    if (!rit)
+    {
+        RETURNFUNC(-RIG_EINVAL);
+    }
+
+    retval = kenwood_get_if(rig);
+
+    if (retval != RIG_OK)
+    {
+        RETURNFUNC(retval);
+    }
+
+    memcpy(buf, &priv->info[18], 5);
+    buf[6] = '\0';
+    *rit = atoi(buf);
+
+    RETURNFUNC(RIG_OK);
+}
+
+/*
+ * rgo_one_v1v5_get_info
+ */
+static const char *rgo_one_v1v5_get_info(RIG *rig)
+{
+    return "RGO ONE V1-V5";
+}
+
+static struct kenwood_priv_caps rgo_one_v1v5_priv_caps =
+{
+    .cmdtrm = EOM_KEN,
+};
+
+/*
+ * rgo_one_v1v5_init
+ *
+ * ag_format = 2: AG0xxx format for AF gain (same as TS-480 and V6).
+ * micgain_min/max: not used (MG not confirmed), but set to TS-480 defaults.
+ */
+static int rgo_one_v1v5_init(RIG *rig)
+{
+    struct kenwood_priv_data *priv;
+    int retval;
+
+    ENTERFUNC;
+
+    retval = kenwood_init(rig);
+
+    if (retval != RIG_OK)
+    {
+        RETURNFUNC(retval);
+    }
+
+    priv = (struct kenwood_priv_data *) STATE(rig)->priv;
+
+    priv->ag_format = 2;
+    priv->micgain_min = 0;
+    priv->micgain_max = 100;
+
+    RETURNFUNC(RIG_OK);
+}
+
+/*
+ * rgo_one_v1v5_open
+ *
+ * ID response is NOT used for strict model matching: V1-V5 sub-versions
+ * may return different ID values. Any response (or no response) is accepted.
+ */
+static int rgo_one_v1v5_open(RIG *rig)
+{
+    int retval;
+    char idbuf[64];
+    struct kenwood_priv_data *priv = (struct kenwood_priv_data *) STATE(rig)->priv;
+
+    ENTERFUNC;
+
+    retval = kenwood_open(rig);
+
+    if (retval != RIG_OK)
+    {
+        RETURNFUNC(retval);
+    }
+
+    retval = kenwood_transaction(rig, "ID", idbuf, sizeof(idbuf));
+
+    if (retval == RIG_OK)
+    {
+        rig_debug(RIG_DEBUG_VERBOSE, "%s: RGO ONE V1-V5 ID: %s\n", __func__, idbuf);
+    }
+    else
+    {
+        rig_debug(RIG_DEBUG_WARN, "%s: could not read ID, assuming RGO ONE V1-V5\n",
+                  __func__);
+    }
+
+    priv->is_emulation = 1;
+
+    RETURNFUNC(RIG_OK);
+}
+
